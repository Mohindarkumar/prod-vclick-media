VITE_API_URL=http://localhost:4000/api/v1

# Cloudflare Turnstile site key (public — safe to commit)
# Get from: https://dash.cloudflare.com → Turnstile → Add Site
# Leave empty in dev to skip the widget entirely.
VITE_TURNSTILE_SITE_KEY=

# Optional CDN base URL for self-hosted video assets (e.g. Bunny, Cloudflare
# Stream, S3 + CloudFront). Leave empty to serve video same-origin from
# Hostinger exactly as before — no code changes needed to switch later.
VITE_VIDEO_CDN_URL=
